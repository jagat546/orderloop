<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Newest GA on 2026-11-02, checked on Maven Central and docs.spring.io (supports Java 17 to 27). -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>app.orderloop</groupId>
  <artifactId>orderloop</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>OrderLoop</name>

  <modules>
    <module>common-dto</module>
    <module>platform-starter</module>
    <module>integration-gateway</module>
    <module>order-orchestrator</module>
    <module>inventory-service</module>
    <module>payment-service</module>
    <module>fulfilment-service</module>
    <module>architecture-tests</module>
  </modules>

  <properties>
    <!-- ScopedValue is final only from Java 25, see ADR 0001. The parent sets maven.compiler.release from this. -->
    <java.version>25</java.version>
    <archunit.version>1.5.1</archunit.version>
    <spotless.version>3.10.4</spotless.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <!-- Surefire and Failsafe read argLine. UTC keeps tests deterministic, and PostgreSQL 18 rejects
         legacy zone aliases such as Asia/Calcutta that the JDBC driver sends from the JVM default. -->
    <argLine>-Duser.timezone=UTC</argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>app.orderloop</groupId>
        <artifactId>common-dto</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>app.orderloop</groupId>
        <artifactId>platform-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <!-- Binds spotless:check to the verify phase, so CI fails on unformatted code. -->
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
